# Copie ce fichier en .env.local et remplis avec tes valeurs

# === Supabase (obligatoire) ===
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# === Google Places API (optionnel — 0.55.39+) ===
# Pour activer les photos / horaires / avis Google des établissements
# https://console.cloud.google.com/google/maps-apis/credentials
# Restreins la clé par référent HTTP : *.vercel.app, localhost:*
# Coût : 1000 req gratuites/mois, ~$17/1000 ensuite
# GOOGLE_PLACES_API_KEY=AIzaSy...
